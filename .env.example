# Copy this file to .env.local for local testing, and add the same keys in Vercel > Settings > Environment Variables.

# Apps Script Web app URL (see apps-script/Code.gs)
LEADS_WEBHOOK_URL=
# Same text as SECRET in apps-script/Code.gs
LEADS_SECRET=

# Optional: Google Ads conversion (defaults are already in app/lib/site.ts)
# NEXT_PUBLIC_GADS_ID=AW-17048613645
# NEXT_PUBLIC_GADS_LEAD_LABEL=o5OfCMKd0-QaEI3mtME_
# NEXT_PUBLIC_GADS_CONTACT_LABEL=QR4cCMK7x7cdEI3mtME_   # default already in app/lib/site.ts

# Optional: Microsoft Clarity project ID (clarity.microsoft.com > Settings > Overview)
# NEXT_PUBLIC_CLARITY_ID=zcxl4lms79

# Which centre this deployment shows. Leave empty for Alambagh (default).
# On the vlcc-kanpur Vercel project set: NEXT_PUBLIC_CITY=kanpur
# NEXT_PUBLIC_CITY=kanpur
# Kanpur gets its own Clarity project id and its own Sheet (LEADS_WEBHOOK_URL / LEADS_SECRET) on that Vercel project.
